d": false, "outcome": null}, "npc_dc99244b21": {"name": "宫中内侍", "gender": "男", "age": 45, "description": "传诏引路的老内侍，腿脚快，宫中路径最熟。", "condition": null, "errand": null, "location_id": "taiji_palace", "displaced": false, "outcome": null}}, "entities": {"seed_3f4623dc8f": {"name": "齐王密信", "entity_type": "item", "state": "covert", "description": "齐王写给东宫亲信的短笺，商议借阅兵调离秦王府精锐之事。", "presence": "at_location", "presence_ref": "donggong", "is_takeable": true, "is_public": true, "created_step": 0, "content": "昆明池饯行之日，壮士伏于幕下，事成则府兵尽归麾下，父皇面前自有说辞。"}, "seed_46a8c1640f": {"name": "东宫兵符", "entity_type": "item", "state": "covert", "description": "太子可调动东宫卫率之铜符，虎形错金，握之可发府兵两千。", "presence": "at_location", "presence_ref": "donggong", "is_takeable": true, "is_public": true, "created_step": 0, "content": ""}, "seed_60e420ca3d": {"name": "秦王甲胄", "entity_type": "item", "state": "covert", "description": "秦王府中私藏的明光铠与弓刀，按制王府不得私备，藏于天策府库。", "presence": "at_location", "presence_ref": "shiliuwang_zhai", "is_takeable": true, "is_public": true, "created_step": 0, "content": ""}, "seed_7ea2abd51a": {"name": "太白密奏", "entity_type": "item", "state": "sealed", "description": "太史令傅奕所呈密封奏章，黄绫封裹，事关天象与国祚。", "presence": "at_location", "presence_ref": "taiji_palace", "is_takeable": true, "is_public": true, "created_step": 0, "content": "太白见秦分，秦王当有天下。谨密奏以闻，伏惟圣裁。"}, "seed_ae43065893": {"name": "调兵手敕", "entity_type": "item", "state": "intact", "description": "皇帝亲笔手敕，召三子入宫对质的诏书底稿，墨迹犹新。", "presence": "at_location", "presence_ref": "taiji_palace", "is_takeable": true, "is_public": true, "created_step": 0, "content": "六月一日，召太子、秦王、齐王黎明入宫，临湖殿对质，务决兄弟之讼。"}}, "relations": {"agent-fae10bdcbc->agent-5716dcbd9e": {"world_id": "415ac277-7552-4dcd-8db5-5b3ccc52d50a", "from_id": "agent-fae10bdcbc", "to_id": "agent-5716dcbd9e", "trust_objective": 0.1, "affection_objective": -0.7, "labels": ["兄弟:哥哥"], "updated_step": 0, "history_summary": "", "interaction_count": 0, "to_name": "李建成", "to_gender": "男"}, "agent-fae10bdcbc->agent-a136496081"