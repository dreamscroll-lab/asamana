ult": "在东宫，李建成与魏征的交谈：\n李建成：屏人都退了。魏卿，齐王已在偏殿，六月初四昆明池饯行——我要与你详议此事。\n魏征：殿下终于肯说这句话了。臣两年前说的话，殿下今日才听。\n李建成：旧事不必再提。眼下要紧的是部署，你且看这份底档。\n魏征：编伍之数在纸上，可秦王耳目遍布，尉迟恭那类人殿下还嫌少吗？饯行之地动手，走漏一分便是大祸。\n李建成：故而只你我与齐王知之。秦王近日在京中可有何异动？\n魏征：臣无确讯。只知太白昼见，秦王府幕客近来出入门下省频繁。殿下若等确讯，就晚了。\n李建成：好。你去拟个章程，初四之前送来，只走我案头。\n魏征：臣领命。只望殿下届时莫再迟疑——迟一步，死的就是殿下。", "last_action_succeeded": true, "short_term_goal_entities": [{"id": "stg-3-1", "text": "我须拟昆明池饯行之谋的章程，六月初四之前送到李建成案头", "goal_type": "short_term", "status": "active", "related_need": null, "created_step": 3, "due_step": 39, "last_evaluated_step": null, "progress_summary": "", "origin": "residue"}], "need_intensities": {"esteem": 0.6, "safety": 0.525, "self_actualization": 0.45, "physiological": 0.3}, "vitality": 0.997, "death_step": null, "condition": null, "last_decision_step": 1, "acted_upon": [], "long_term_goal_entities": [{"id": "ltg-44708", "text": "让主君明白局势凶险，赶在无法挽回之前定策", "goal_type": "long_term", "status": "active", "related_need": null, "created_step": 0, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}, {"id": "ltg-16316", "text": "在储位之争的乱局中保全自身与东宫旧属", "goal_type": "long_term", "status": "active", "related_need": null, "created_step": 0, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}, {"id": "ltg-12535", "text": "让自己洞悉时局的判断被世人验证", "goal_type": "long_term", "status": "active", "related_need": null, "created_step": 0, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}], "memory_seq": 3, "agent_name": "魏征", "is_main_character": false, "gender": "男", "age": 36, "color": "#5a7be0", "location_id": "donggong"}}, "npcs": {"npc_283fadd050": {"name": "东宫卫卒", "gender": "男", "age": 28, "description": "太子宿卫，甲械齐整，只听东宫令符。", "condition": null, "errand": null, "location_id": "donggong", "displaced": false, "outcome": null}, "npc_363ea93340": {"name": "皇城书吏", "gender": "男", "age": 40, "description": "三省抄录文书的小吏，笔快，认得百官名姓。", "condition": null,