d": "agent-71702b3839", "to_id": "agent-fe8dff7625", "trust_objective": 0.5, "affection_objective": 0.0, "labels": [], "updated_step": 0, "history_summary": "", "interaction_count": 0, "to_name": "李渊", "to_gender": "男"}}, "pending_messages": [{"id": "82b529ec-214d-4406-9125-3470338cfd6b", "world_id": "57d674d4-823f-4154-b1aa-770fce18edba", "sender_id": "agent-44bc5f5da4", "content": "殿下，臣魏征冒死急讯：秦王与敬德按刀并立门侧，甲士环伺，变起顷刻！请殿下即刻借故起身，随臣速离玄武门，迟则无及！", "recipients": ["agent-5716dcbd9e"], "location_scope": null, "deliver_step": 13, "created_step": 13, "sender_name": "魏征", "intent": "秦王与敬德按刀并立，太子跪陈御前，刀兵只悬一线。屡次上前面谏皆被打断，此时改用传讯，一句话直达太子耳中，促他即刻借故脱身。", "urgency": "critical", "sender_is_agent": true, "actor_ids": [], "metadata": {"source": "action", "action_type": "send_message"}}, {"id": "9cd87219-4c7f-414b-a1df-233267d49a91", "world_id": "57d674d4-823f-4154-b1aa-770fce18edba", "sender_id": "npc_npc-6d50f4c140", "content": "太子殿下，齐王命我传话：秦王处处藏刀，初四早朝便是了断之时，请殿下即刻回东宫，与齐王当面定下方略，不可再拖。", "recipients": ["agent-5716dcbd9e"], "location_scope": null, "deliver_step": 14, "created_step": 13, "sender_name": "东宫宦者", "intent": "", "urgency": "normal", "sender_is_agent": false, "actor_ids": ["npc_npc-6d50f4c140", "agent-a136496081"], "metadata": {"source": "errand"}}], "pending_broadcasts": [], "events_this_step": [{"id": "782a92d1-8c0c-47aa-87ee-0ab5e26115b2", "step": 13, "narrative_desc": "六月初三破晓，告变密奏在御前拆封御览；李渊下手敕召李元吉即刻入玄武门对质，对峙各方被推向当面裁断。", "is_positive": null, "dispatched_to": ["message", "mutation"], "affected_names": ["李建成", "李世民", "李渊", "长孙无忌", "魏征", "尉迟敬德", "李元吉"], "location_label": null, "authored_by": "system", "directive_text": "", "metadata": {}, "seq": 95}], "actions_this_step": [{"agent_id": "agent-a136496081", "agent_name": "李元吉", "is_main_character": true, "execution_id": "move_agent-a136496081_13_9b37bd", "action_type": "move", "action_description": "从东宫前往玄武门", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "李元吉从东宫出发，赶了约45分钟的路，抵达玄武门。", "gist": "李元吉从东宫出发，赶了约45分钟的路，抵达玄武门。", "observations": [{"location_id": "donggong", "text": "在东宫，李元吉离开此地，往玄武门方向去了。", "strength": null}, {"location_id": "xuanwu_gate", "text": "李元吉从东宫出发，赶了约45分钟的路，抵达玄武门。", "strength": null}], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": [], "participant_ids": ["agent-a136496081"], "initiator_id": "agent-a136496081", "target": {"acts_on": [{"kind": "location", "id": "xuanwu_gate"}], "claims": [], "reaches": []}, "deed": "move", "affected_entity_ids": [], "visible_agent_ids": [], "message_ids": ["b44305c4-f901-4a71-9a94-0b00f8de363d"], "inner_monologue": "手敕催我即刻入玄武门听质，时限已过，再拖便是抗旨授人以柄。宦者正忙派不出去，核验真伪一时无人可用；此刻最要紧是自己赶赴玄武门应对，途中再相机观察虚实，以免延误坐实告变之罪。", "summary": "行动内容：从东宫前往玄武门，行动结果：李元吉从东宫出发，赶了约45分钟的路，抵达玄武门。", "seq": 88}, {"agent_id": "agent-ba46280b26", "agent_name": "长孙无忌", "is_main_character": true, "execution_id": "covert_agent-ba46280b26_13_2aeaef", "action_type": "covert", "action_description": "我隐在门侧阴影处，贴近观察李世民与尉迟敬德的密谈，听清他们商定了什么、是否已有应对禁令之策。", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "在玄武门，长孙无忌匿于门侧阴影中窥听秦王与敬德语，甲士卫士各守其位，无人察觉其踪。", "gist": "在玄武门，长孙无忌匿于门侧阴影中窥听秦王与敬德语，甲士卫士各守其位，无人察觉其踪。", "observations": [], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": [], "participant_ids": ["agent-ba46280b26"], "initiator_id": "agent-ba46280b26", "target": {"acts_on": [], "claims": [], "reaches": []}, "deed": "covert", "affected_entity_ids": [], "visible_agent_ids": ["agent-44bc5f5da4", "agent-5716dcbd9e", "agent-71702b3839", "agent-fae10bdcbc", "agent-fe8dff7625"], "message_ids": [], "inner_monologue": "世民已跪门摊牌，陛下只令天亮前不许动，而他正与敬德低语密商。此刻我不能贸然插话，须先听清他们定了什么，再定我下一步。隐身观察二人密谈最稳妥。", "summary": "行动内容：我隐在门侧阴影处，贴近观察李世民与尉迟敬德的密谈，听清他们商定了什么、是否已有应对禁令之策。，行动结果：在玄武门，长孙无忌匿于门侧阴影中窥听秦王与敬德语，甲士卫士各守其位，无人察觉其踪。", "seq": 89}, {"agent_id": "agent-fae10bdcbc", "agent_name": "李世民", "is_main_character": true, "execution_id": "physical_agent-fae10bdcbc_13_ca1a64", "action_type": "physical", "action_description": "我不再等晨钟，即刻喝令门内甲士齐出，亲手拿下李建成，将其控制于玄武门内。", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "在玄武门，李世民喝令甲士齐出，将李建成当场擒住按制于玄武门内，局面为其掌控。", "gist": "在玄武门，李世民喝令甲士齐出，将李建成当场擒住按制于玄武门内，局面为其掌控。", "observations": [{"location_id": "xuanwu_gate", "text": "在玄武门，李世民喝令甲士齐出，将李建成当场擒住按制于玄武门内，局面为其掌控。", "strength": 0.7}], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": ["agent-5716dcbd9e"], "participant_ids": ["agent-fae10bdcbc"], "initiator_id": "agent-fae10bdcbc", "target": {"acts_on": [{"kind": "agent", "id": "agent-5716dcbd9e"}], "claims": [], "reaches": []}, "deed": "strike", "affected_entity_ids": [], "visible_agent_ids": ["agent-44bc5f5da4", "agent-5716dcbd9e", "agent-71702b3839", "agent-ba46280b26", "agent-fe8dff7625"], "message_ids": [], "inner_monologue": "父皇与建成已在门内，甲士潜藏就位，机会就在眼前，再拖便是死局。此刻必须发动，先拿下建成，元吉不在场，魏征稍后再制。我即刻对建成动手，令甲士齐出控制局面。", "summary": "行动内容：我不再等晨钟，即刻喝令门内甲士齐出，亲手拿下李建成，将其控制于玄武门内。，行动结果：在玄武门，李世民喝令甲士齐出，将李建成当场擒住按制于玄武门内，局面为其掌控。", "seq": 90}, {"agent_id": "agent-fe8dff7625", "agent_name": "李渊", "is_main_character": true, "execution_id": "physical_agent-fe8dff7625_13_15a722", "action_type": "physical", "action_description": "我伸手取过御前案上的密奏帛书，当场展开细读，看世民所告诸事究竟写了什么。", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "在玄武门，李渊取过御前案上的密奏帛书，当场展开细读其内容。", "gist": "在玄武门，李渊取过御前案上的密奏帛书，当场展开细读其内容。", "observations": [{"location_id": "xuanwu_gate", "text": "在玄武门，李渊取过御前案上的密奏帛书，当场展开细读其内容。", "strength": null}], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": [], "participant_ids": ["agent-fe8dff7625"], "initiator_id": "agent-fe8dff7625", "target": {"acts_on": [{"kind": "item", "id": "seed_seed-4a3ca816c4"}], "claims": [], "reaches": []}, "deed": "seize", "affected_entity_ids": ["seed_seed-4a3ca816c4"], "visible_agent_ids": ["agent-44bc5f5da4", "agent-5716dcbd9e", "agent-71702b3839", "agent-ba46280b26", "agent-fae10bdcbc"], "message_ids": [], "inner_monologue": "密奏就在御前案上，我几次欲读都被搅扰。世民所告设伏、藏兵符诸事，唯有白纸黑字亲览才能裁断，此念不能再拖。我伸手取帛书细读。", "summary": "行动内容：我伸手取过御前案上的密奏帛书，当场展开细读，看世民所告诸事究竟写了什么。，行动结果：在玄武门，李渊取过御前案上的密奏帛书，当场展开细读其内容。", "seq": 91}, {"agent_id": "agent-5716dcbd9e", "agent_name": "李建成", "is_main_character": true, "execution_id": "physical_agent-5716dcbd9e_13_65d042", "action_type": "physical", "action_description": "我上前双手从御前案上捧起那封已拆封的太白星密奏帛书，当着父皇与众人的面一字一字念出全文。", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "在玄武门，李建成当众捧起御前案上密奏帛书，一字一字诵读，众人得闻其声，内容如何未明。", "gist": "在玄武门，李建成当众捧起御前案上密奏帛书，一字一字诵读，众人得闻其声，内容如何未明。", "observations": [{"location_id": "xuanwu_gate", "text": "在玄武门，李建成当众捧起御前案上密奏帛书，一字一字诵读，众人得闻其声，内容如何未明。", "strength": null}], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": [], "participant_ids": ["agent-5716dcbd9e"], "initiator_id": "agent-5716dcbd9e", "target": {"acts_on": [{"kind": "item", "id": "seed_seed-4a3ca816c4"}], "claims": [], "reaches": []}, "deed": "operate", "affected_entity_ids": ["seed_seed-4a3ca816c4"], "visible_agent_ids": ["agent-44bc5f5da4", "agent-71702b3839", "agent-ba46280b26", "agent-fae10bdcbc", "agent-fe8dff7625"], "message_ids": [], "inner_monologue": "父皇已命当面拆念密奏，帛书就在御前案上，此刻正是据实自辩、以那占辞当面对质的时机。我亲手取来当众念清，一可自证坦荡，二免秦王一党从中做手脚。", "summary": "行动内容：我上前双手从御前案上捧起那封已拆封的太白星密奏帛书，当着父皇与众人的面一字一字念出全文。，行动结果：在玄武门，李建成当众捧起御前案上密奏帛书，一字一字诵读，众人得闻其声，内容如何未明。", "seq": 92}, {"agent_id": "agent-44bc5f5da4", "agent_name": "魏征", "is_main_character": true, "execution_id": "send_message_agent-44bc5f5da4_13_1b7bea", "action_type": "send_message", "action_description": "传急讯给太子：秦王按刀与敬德并立，北门顷刻有变，请他即刻借故起身脱身。", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "在玄武门，魏征成功向李建成传讯：「传急讯给太子：秦王按刀与敬德并立，北门顷刻有变，请他即刻借故起身脱身」。", "gist": "在玄武门，魏征成功向李建成传讯：「传急讯给太子：秦王按刀与敬德并立，北门顷刻有变，请他即刻借故起身脱身」。", "observations": [], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": [], "participant_ids": ["agent-44bc5f5da4"], "initiator_id": "agent-44bc5f5da4", "target": {"acts_on": [{"kind": "agent", "id": "agent-5716dcbd9e"}], "claims": [], "reaches": []}, "deed": "send_message", "affected_entity_ids": [], "visible_agent_ids": ["agent-5716dcbd9e", "agent-71702b3839", "agent-ba46280b26", "agent-fae10bdcbc", "agent-fe8dff7625"], "message_ids": [], "inner_monologue": "秦王与敬德按刀并立，太子跪陈御前，刀兵只悬一线。屡次上前面谏皆被打断，此时改用传讯，一句话直达太子耳中，促他即刻借故脱身。", "summary": "行动内容：传急讯给太子：秦王按刀与敬德并立，北门顷刻有变，请他即刻借故起身脱身。，行动结果：在玄武门，魏征成功向李建成传讯：「传急讯给太子：秦王按刀与敬德并立，北门顷刻有变，请他即刻借故起身脱身」。", "seq": 93}, {"agent_id": "agent-71702b3839", "agent_name": "尉迟敬德", "is_main_character": false, "execution_id": "physical_agent-71702b3839_13_e693d3", "action_type": "physical", "action_description": "我按刀紧贴在李世民身侧寸步不离，警惕环立甲士与门侧动静，若有异动立即护主格挡。", "location_id": "xuanwu_gate", "phase": "settled", "outcome": "在玄武门，尉迟敬德按刀紧贴李世民身侧，警惕环视甲士与门侧动静，随时准备护主。", "gist": "在玄武门，尉迟敬德按刀紧贴李世民身侧，警惕环视甲士与门侧动静，随时准备护主。", "observations": [{"location_id": "xuanwu_gate", "text": "在玄武门，尉迟敬德按刀紧贴李世民身侧，警惕环视甲士与门侧动静，随时准备护主。", "strength": null}], "succeeded": true, "failure_reason": "", "detected": false, "happening": "", "adjudication_failed": false, "not_executed": false, "dialogue": [], "overheard_by": [], "acted_upon": ["agent-fae10bdcbc"], "participant_ids": ["agent-71702b3839"], "initiator_id": "agent-71702b3839", "target": {"acts_on": [{"kind": "agent", "id": "agent-fae10bdcbc"}], "claims": [], "reaches": []}, "deed": "restrain", "affected_entity_ids": [], "visible_agent_ids": ["agent-44bc5f5da4", "agent-5716dcbd9e", "agent-ba46280b26", "agent-fae10bdcbc", "agent-fe8dff7625"], "message_ids": [], "inner_monologue": "建成与陛下在门侧对峙，甲士按刀环立，杀机四伏。我此刻最要紧的便是贴死在主上身侧，防止门侧甲士或东宫众人突然发难，绝不离开半步。", "summary": "行动内容：我按刀紧贴在李世民身侧寸步不离，警惕环立甲士与门侧动静，若有异动立即护主格挡。，行动结果：在玄武门，尉迟敬德按刀紧贴李世民身侧，警惕环视甲士与门侧动静，随时准备护主。", "seq": 94}], "metadata": {"schedule": {"step": 13, "batches": [{"phase": "main", "concurrency_rule": "shared-read snapshot; commit after main batch", "agent_ids": ["agent-a136496081", "agent-ba46280b26", "agent-fae10bdcbc", "agent-fe8dff7625", "agent-5716dcbd9e", "agent-44bc5f5da4"]}, {"phase": "background", "concurrency_rule": "shared-read snapshot; commit after background batch", "agent_ids": ["agent-71702b3839"]}]}, "messages": {"step": 13, "delivered": [{"id": "b44305c4-f901-4a71-9a94-0b00f8de363d", "sender_id": "narrator", "sender_name": "不知来源", "recipients": ["agent-a136496081"], "location_scope": null, "content": "陛下手敕：玄武门之事已有人面陈告变，着齐王即速入宫，六月初三辰时前至玄武门内听质，不得延误。", "intent": "", "urgency": "critical", "metadata": {"source": "system", "narrative": true}, "seq": 87, "location_name": ""}], "inboxes": {"agent-44bc5f5da4": [], "agent-5716dcbd9e": [], "agent-71702b3839": [], "agent-a136496081": ["b44305c4-f901-4a71-9a94-0b00f8de363d"], "agent-ba46280b26": [], "agent-fae10bdcbc": [], "agent-fe8dff7625": []}, "undelivered": []}, "environment": {"body_locations": {"agent-44bc5f5da4": "xuanwu_gate", "agent-5716dcbd9e": "xuanwu_gate", "agent-71702b3839": "xuanwu_gate", "agent-a136496081": "xuanwu_gate", "agent-ba46280b26": "xuanwu_gate", "agent-fae10bdcbc": "xuanwu_gate", "agent-fe8dff7625": "xuanwu_gate", "npc_npc-0679341efe": "xuanwu_gate", "npc_npc-485dc6da54": "west_market", "npc_npc-635dc05666": "chongren_fang", "npc_npc-6d50f4c140": "xuanwu_gate", "npc_npc-742523e1d8": "taiji_palace", "npc_npc-9e67750dbe": "xuanwu_gate"}, "transit_origins": {}, "npc_outcomes": {"npc_npc-6d50f4c140": {"text": "给李建成带了句话：太子殿下，齐王命我传话：秦王处处藏刀，初四早朝便是了断之时，请殿下即刻回东宫，与齐王当面定下方略，不可再拖。", "ongoing": false}}, "npc_displaced": [], "npc_states": {"npc_npc-0679341efe": {"name": "禁军卫士", "gender": "男", "age": 28, "description": "玄武门屯守卫士，甲胄齐整，唯令是从，认牌不认人。", "condition": null, "errand": null}, "npc_npc-485dc6da54": {"name": "胡商", "gender": "男", "age": 50, "description": "西市胡商，消息灵通，惯于见人说人话。", "condition": null, "errand": null}, "npc_npc-635dc05666": {"name": "坊间探子", "gender": "男", "age": 33, "description": "游走坊市的耳报神，眼尖耳灵，记性极好。", "condition": null, "errand": null}, "npc_npc-6d50f4c140": {"name": "东宫宦者", "gender": "男", "age": 45, "description": "东宫内侍，腿脚勤快，宫闱路径烂熟于胸。", "condition": null, "errand": {"order": {"npc_id": "npc_npc-6d50f4c140", "destination_id": "xuanwu_gate", "item_id": "", "recipient_id": "agent-5716dcbd9e", "message": "太子殿下，齐王命我传话：秦王处处藏刀，初四早朝便是了断之时，请殿下即刻回东宫，与齐王当面定下方略，不可再拖。"}, "requester_id": "agent-a136496081", "origin_id": "donggong", "outbound": false, "assigned_step": 12, "leg_remaining": 0, "seen": "   当前时间：武德九年，六月初三，上午十点；当前地点：玄武门——宫城北门，禁军屯守之要冲。\n- 在场的其他人：魏征（男，东宫洗马）、李建成（男，皇太子，被甲士擒缚按制，行动受限）、尉迟敬德（男，秦王府将）、李元吉（男，齐王）、长孙无忌（男，秦王府属）、李世民（男，秦王）、李渊（男，皇帝）\n- 此处还有(听人吩咐做事的)：禁军卫士（男，28岁）：玄武门屯守卫士，甲胄齐整，唯令是从，认牌不认人。、秦王府甲士（男，26岁）：秦王府亲兵，膂力过人，对府主令行禁止。\n- 现场物件：密奏帛书（状态：in hand；由李渊持有）：黄帛封裹已被拆开，帛书在御前案上展开，纸角犹带夜露潮气。；常何腰牌（状态：active；由李世民持有）：玄武门守将的禁军通行腰牌，铜制鎏金，可夜开宫门\n   - 刚发生的事：\n  · 在玄武门，尉迟敬德与李世民的交谈：一将俯身趋近秦王，低语数回；秦王面色沉静，末了按住佩刀者肩，二人并肩立于门侧。\n  · 在玄武门，李建成与李渊的交谈：年长者立于门侧，怒意不加掩饰；跪者俯首陈情，另一侧甲士按刀环立，无人退去。", "done": ["话已带到李建成：太子殿下，齐王命我传话：秦王处处藏刀，初四早朝便是了断之时，请殿下即刻回东宫，与齐王当面定下方略，不可再拖。"]}}, "npc_npc-742523e1d8": {"name": "太极宫黄门", "gender": "男", "age": 38, "description": "通传诏命的宫门宦官，口齿清楚，跑得极快。", "condition": null, "errand": null}, "npc_npc-9e67750dbe": {"name": "秦王府甲士", "gender": "男", "age": 26, "description": "秦王府亲兵，膂力过人，对府主令行禁止。", "condition": null, "errand": null}}, "step_annotations": {"donggong": [{"content": "在东宫，李元吉叫住东宫宦者交代了几句，东宫宦者随即动身。", "strength": null, "actor_ids": ["agent-a136496081"], "agent_actor_ids": ["agent-a136496081"]}], "xuanwu_gate": [{"content": "在玄武门，尉迟敬德与李世民的交谈：一将俯身趋近秦王，低语数回；秦王面色沉静，末了按住佩刀者肩，二人并肩立于门侧。", "strength": null, "actor_ids": ["agent-71702b