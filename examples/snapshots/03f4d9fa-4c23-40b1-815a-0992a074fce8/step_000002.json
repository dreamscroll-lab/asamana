搬空了，不是鬼是什么。\n顾小满：嗨，说不定就是巧了嘛，咱们队里谁会干那事呀。\n邱大山：巧？我看就是身边人。谁手脚不干净，早晚露尾巴，我盯得到。\n顾小满：那……查起来得些日子吧？队里气氛怪紧的。\n邱大山：昨夜我放话了，谁揪出来我请客一个月。小满，你怕什么？我还没问你呢，入队不到一年，外勤倒抢着跑。\n顾小满：我那是想多学点嘛……邱哥说笑，我先上去了，回头聊。\n邱大山：去吧。学归学，别学岔了道。", "last_action_succeeded": false, "short_term_goal_entities": [{"id": "stg-2-1", "text": "陪顾小满周旋，稳住口风，留意她的言行举动找疑点", "goal_type": "short_term", "status": "active", "related_need": "safety", "created_step": 2, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}, {"id": "stg-2-2", "text": "另约沈墨和唐一笑当面碰头，把排查内鬼的下一步方向掰扯清楚", "goal_type": "short_term", "status": "active", "related_need": "safety", "created_step": 2, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}], "need_intensities": {"esteem": 0.675, "safety": 0.6, "social": 0.525, "physiological": 0.3}, "vitality": 0.998, "death_step": null, "condition": null, "last_decision_step": 2, "acted_upon": [], "long_term_goal_entities": [{"id": "ltg-51330", "text": "把行动屡次扑空的窟窿查个水落石出", "goal_type": "long_term", "status": "active", "related_need": null, "created_step": 0, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}, {"id": "ltg-40010", "text": "学会遇事先核实证据再开口", "goal_type": "long_term", "status": "active", "related_need": null, "created_step": 0, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}, {"id": "ltg-67879", "text": "在队里保住自己被人信得过的位置", "goal_type": "long_term", "status": "active", "related_need": null, "created_step": 0, "due_step": null, "last_evaluated_step": null, "progress_summary": "", "origin": "cognitive"}], "memory_seq": 5, "agent_name": "邱大山", "is_main_character": true, "gender": "男", "age": 36, "color": "#e07a4a", "location_id": "riverside_heights"}, "agent-83f8f101f8": {"world_id": "03f4d9fa-4c23-40b1-815a-0992a074fce8", "agent_id": "agent-83f8f101f8", "step": 2, "emotion": {"primary": "anticipation", "intensity": 0.45, "valence": 0.55, "