# --- Provider keys (backend) -----------------------------------------------
# `./asamana.sh setup` writes `.env` (gitignored) for you; `./asamana.sh keys` adds or changes
# the keys later. To do it by hand instead, copy this file to `.env` and fill in real values.
# Set every key the config uses, or none: with none the backend starts without models (stored
# worlds can be browsed, nothing can be built or run); with only some it refuses to start.
# Which variables you need depends on the config: an LLM provider reads the variable its
# `api_key_env` names, or LLM_API_KEY when it names none. They are the operator's keys, not any
# end user's.

# LLM providers that name no `api_key_env` (config/config.yaml).
LLM_API_KEY=

# The embedding provider — a separate axis, so it may be a different vendor and a different
# account. Same account as the LLM? Put the same value in both.
EMBEDDING_API_KEY=

# LLM providers that name their own variable via `api_key_env`: every preset does (e.g.
# DEEPSEEK_API_KEY / MOONSHOT_API_KEY, listed in the preset's header), and so must each vendor
# when one config connects two or more. Add them here to match.

# Some configs put a deployment value inside an endpoint URL. The DashScope GLM preset
# (config/presets/dashscope_glm.yaml) needs your DashScope workspace id:
# DASHSCOPE_WORKSPACE_ID=

# --- Optional -------------------------------------------------------------
# Which config the backend loads. Default config/config.yaml (Alibaba Bailian / DashScope).
# Vendor presets live in config/presets/, e.g.:
# ASAMANA_CONFIG=config/presets/deepseek.yaml

# Comma-separated origins allowed to call the API from a browser. Default "*".
# Only needed when the frontend is served from a different origin WITHOUT the
# bundled nginx proxy (e.g. a CDN-hosted build). Restrict in production.
# ASAMANA_CORS_ORIGINS=https://app.example.com

# Developer tools: trace explorer, audit runner, prompt playground, map workbench.
# They spawn subprocesses and send arbitrary prompts to the paid LLM — never on a machine
# others can reach.
# ASAMANA_DEV_TOOLS=true
